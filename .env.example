# ─── Servidor ────────────────────────────────────────────────
PORT=8000

# ─── PostgreSQL + PostGIS ─────────────────────────────────────
DB_HOST=postgres-localizacion
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ms_localizacion

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=sanos_y_salvos_events

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=*
